{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/hooks/useElderChat.ts"],
  "types": ["node"]
}
