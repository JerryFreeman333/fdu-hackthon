{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"],
  "exclude": [
    "src/App.tsx",
    "src/hooks/useElderChat.ts",
    "src/config/runtime.ts",
    "src/adapters/parserSelector.ts",
    "src/components/RuntimeModeBanner.tsx"
  ],
  "types": ["node"]
}
