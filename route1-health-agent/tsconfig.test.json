{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "types": ["node"]
}
