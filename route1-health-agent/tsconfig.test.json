{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "tests/**/*.ts",
    "src/engine/**/*.ts",
    "src/adapters/**/*.ts",
    "src/pipeline/**/*.ts",
    "src/types.ts"
  ],
  "types": []
}
