# ============================================================
# 理解层 LLM 语义仲裁（可选；不配置 = 纯规则模式，功能可用但
# 否定/程度口语的判断完全依赖本地结构化规则兜底）
# ============================================================
# 任何 OpenAI 兼容 /chat/completions 端点，例如：
#   智谱 GLM:   https://open.bigmodel.cn/api/paas/v4
#   DeepSeek:   https://api.deepseek.com
#   MiniMax:    https://api.minimaxi.com/v1（M3 为推理模型，思考 token 计入 completion）
VITE_UNDERSTANDING_LLM_BASE_URL=
VITE_UNDERSTANDING_LLM_API_KEY=
# 模型名，例如 glm-4-flash（免费档）、deepseek-chat
VITE_UNDERSTANDING_LLM_MODEL=glm-4-flash
# 单次仲裁超时（毫秒）；超时/失败自动回落规则结果，不阻塞对话
VITE_UNDERSTANDING_LLM_TIMEOUT_MS=8000

# ============================================================
# 跨设备协同信令（可选；不配置 = PeerJS 官方公共信令）
# ============================================================
# 中国大陆网络下官方公共信令（0.peerjs.com）不稳定，建议自建：
#   npx peerjs --port 9000 --key ankang
# 然后填: VITE_PEER_SIGNALING_URL=http://<你的服务器IP>:9000/peerjs
VITE_PEER_SIGNALING_URL=
# 自定义 ICE/TURN（JSON 数组），需要 NAT 穿透增强时使用
# VITE_PEER_ICE_SERVERS=[{"urls":"turn:turn.example.cn:3478","username":"u","credential":"p"}]
VITE_PEER_ICE_SERVERS=

# ============================================================
# 路线联动端口（路线一前端 5173 → 路线二 Home Twin 前端 5174）
# ============================================================
VITE_HOME_TWIN_URL=http://localhost:5174
VITE_HOME_TWIN_API_URL=http://localhost:8010
