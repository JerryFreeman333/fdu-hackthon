{
  "name": "route1-health-agent",
  "private": true,
  "version": "0.1.0",
  "description": "路线一：老年健康 Agent 原型 —— 个人基线 + 变化检测 + 分级家属通知",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "tsc -p tsconfig.test.json && printf '{\"type\":\"commonjs\"}' > .test-build/package.json && node --test .test-build/tests/*.test.js",
    "build": "npm run typecheck && vite build",
    "format": "npx --yes prettier@3.5.3 --write .",
    "format:check": "npx --yes prettier@3.5.3 --check .",
    "security:check": "node scripts/security-check.mjs",
    "verify:llm": "node scripts/verify-llm-understanding.mjs",
    "proxy": "node scripts/local-llm-proxy.mjs",
    "ci": "npm run format:check && npm run typecheck && npm test && npm run build && npm run security:check && npm run test:browser && npm run test:browser:sos && npm run test:browser:notif && npm run test:browser:cross-device",
    "preview": "vite preview",
    "test:browser": "node tests/browser-smoke.test.mjs",
    "test:browser:sos": "node tests/elder-sos-blackbox.test.mjs",
    "test:browser:notif": "node tests/notification-push-blackbox.test.mjs",
    "test:browser:cross-device": "node tests/cross-device-status-blackbox.test.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2"
}
