{
  "name": "route1-health-agent",
  "private": true,
  "version": "0.1.0",
  "description": "路线一：老年健康 Agent 原型 —— 个人基线 + 变化检测 + 分级家属通知",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "tsc -p tsconfig.test.json && printf '{\"type\":\"commonjs\"}' > .test-build/package.json && node --test .test-build/tests/detection.test.js .test-build/tests/numeric-extraction.test.js",
    "preview": "vite preview",
    "format": "npx --yes prettier@3.6.2 --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
